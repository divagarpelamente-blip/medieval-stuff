{
  // Ativa a extensão Deno apenas na pasta das Supabase Functions
  "deno.enable": true,
  "deno.path": "",
  "deno.enablePaths": [
    "supabase/functions"
  ],
  "deno.lint": true,
  "deno.unstable": false,

  // Impede que o servidor de linguagem do TypeScript do Node valide a pasta das funções
  "typescript.validate.enable": false
}